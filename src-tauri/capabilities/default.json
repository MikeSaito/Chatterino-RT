{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Главное окно: без создания окон и WebView",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:webview:deny-create-webview",
    "core:webview:deny-create-webview-window",
    "core:window:deny-create"
  ]
}
