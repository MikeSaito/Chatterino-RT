TWITCH_OAUTH_TOKEN=YOUR_API_KEY_HERE
TWITCH_LOGIN=YOUR_LOGIN_HERE
TWITCH_CLIENT_ID=YOUR_API_KEY_HERE

# Auto-update endpoints (optional HTTPS overrides). Pubkey is NOT here —
# set plugins.updater.pubkey in tauri.conf.json (baked into the binary).
# These must be real process environment variables (OS/CI). A Vite/.env file
# is not loaded by the Rust updater at runtime.
CHATTERINO_RT_UPDATER_ENDPOINT=https://YOUR_UPDATE_CDN_HOST/chatterino-rt/{{target}}/{{arch}}/latest.json
CHATTERINO_RT_UPDATER_ENDPOINT_BETA=https://YOUR_UPDATE_CDN_HOST/chatterino-rt/beta/{{target}}/{{arch}}/latest.json

# Signing at release build time only (never commit real values).
# TAURI_SIGNING_PRIVATE_KEY=YOUR_TAURI_SIGNING_PRIVATE_KEY_HERE
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD=YOUR_TAURI_SIGNING_PRIVATE_KEY_PASSWORD_HERE
